# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Which inference route to use. See app/extraction/client.py.
#   vertex-eu        Google Cloud Vertex AI, EU region   — production
#   bedrock-eu       Amazon Bedrock, EU region           — production
#   dev-unrestricted first-party API, region NOT guaranteed EU — development only
GASTROBELEG_RESIDENCY=dev-unrestricted

# Required only for dev-unrestricted. A second, explicit acknowledgement that
# this route does not satisfy CLAUDE.md § 2.5. Never set this in production.
GASTROBELEG_ALLOW_NON_EU=true

# --- dev-unrestricted ---
ANTHROPIC_API_KEY=

# --- vertex-eu ---
# ANTHROPIC_VERTEX_REGION=europe-west4
# ANTHROPIC_VERTEX_PROJECT=
# Auth is GCP ADC: gcloud auth application-default login

# --- bedrock-eu ---
# AWS_REGION=eu-central-1
# Auth is the standard AWS credential chain
